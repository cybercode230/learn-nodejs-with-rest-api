{
  "expo": {
    "name": "airbnb-mobile",
    "slug": "airbnb-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logos/logo.svg",
    "scheme": "airbnbmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/logos/logo.svg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logos/logo.svg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logos/logo.svg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Figtree/static/Figtree-Regular.ttf",
            "./assets/fonts/Figtree/static/Figtree-Bold.ttf",
            "./assets/fonts/Figtree/static/Figtree-Medium.ttf",
            "./assets/fonts/Figtree/static/Figtree-SemiBold.ttf",
            "./assets/fonts/Figtree/static/Figtree-Light.ttf"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
